From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ashwin Devi Srinivasan <ashwin@ashds.dev>
Date: Tue, 20 Oct 2026 16:39:20 +0000
Subject: [PATCH] Drop MIUI backup agent

CameraBackupAgent extends miui.app.backup.FullBackupAgent, which only
exists in the MIUI framework. Any backup pass that binds the agent on a
non-MIUI system fails to load the class and kills the camera process.
Without a custom agent the app falls back to the platform's default
full-backup agent.

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index d2f379b1..f6b7e647 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -59,7 +59,7 @@
     <uses-permission android:name="com.miui.maintenancemode.model.MaintenanceModeProvider.read" android:protectionLevel="normal"/>
     <uses-permission android:name="com.miui.maintenancemode.model.MaintenanceModeProvider.write" android:protectionLevel="normal"/>
     <uses-permission android:name="com.miui.securitycenter.permission.SYSTEM_PERMISSION_DECLARE"/>
-    <application android:allowBackup="true" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:backupAgent="com.android.camera.backup.CameraBackupAgent" android:extractNativeLibs="false" android:hardwareAccelerated="true" android:icon="@mipmap/ic_launcher_camera" android:label="@string/camera_label" android:largeHeap="true" android:name="com.android.camera.CameraAppImpl" android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true" android:theme="@style/ThemeCamera">
+    <application android:allowBackup="true" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:extractNativeLibs="false" android:hardwareAccelerated="true" android:icon="@mipmap/ic_launcher_camera" android:label="@string/camera_label" android:largeHeap="true" android:name="com.android.camera.CameraAppImpl" android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true" android:theme="@style/ThemeCamera">
         <uses-library android:name="micloud-sdk" android:required="false"/>
         <meta-data android:name="required_permissions" android:value="@string/required_permissions"/>
         <meta-data android:name="com.miui.bugreport.LOG_DIR" android:resource="@xml/log_paths"/>
